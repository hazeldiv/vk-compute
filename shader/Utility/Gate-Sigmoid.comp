#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint count;
} params;

layout(set = 0, binding = 0) readonly restrict buffer GateBuffer { float g[]; };
layout(set = 0, binding = 1) restrict buffer OutBuffer { float o[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.count) return;
    float x = g[i];
    o[i] *= x / (1.0 + exp(-x));
}
