#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable

#define TS 64

layout(local_size_x = TS, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Dims { uint K; } dims;

layout(set = 0, binding = 0) readonly restrict buffer X { vec4 x[]; };
layout(set = 0, binding = 1) writeonly restrict buffer InvRms { float invRms[]; };

shared float red_sh[TS];

float wgAdd(float v) {
    uint lane = gl_LocalInvocationID.x;
    red_sh[lane] = v;
    barrier();
    for (uint stride = TS / 2u; stride > 0u; stride >>= 1u) {
        if (lane < stride) red_sh[lane] += red_sh[lane + stride];
        barrier();
    }
    float r = red_sh[0];
    barrier();
    return r;
}

void main() {
    uint m = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    float sum = 0.0;
    for (uint i = lane; i < dims.K / 4; i += TS) {
        vec4 v = x[m * (dims.K / 4) + i];
        sum += dot(v, v);
    }
    sum = wgAdd(sum);
    if (lane == 0u) invRms[m] = inversesqrt(sum / float(dims.K) + 1e-6);
}
