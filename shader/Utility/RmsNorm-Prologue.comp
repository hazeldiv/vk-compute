#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Dims { uint K; } dims;

layout(set = 0, binding = 0) readonly restrict buffer X { vec4 x[]; };
layout(set = 0, binding = 1) writeonly restrict buffer InvRms { float invRms[]; };

void main() {
    uint m = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    float sum = 0.0;
    for (uint i = lane; i < dims.K / 4; i += 64) {
        vec4 v = x[m * (dims.K / 4) + i];
        sum += dot(v, v);
    }
    sum = subgroupAdd(sum);
    if (subgroupElect()) invRms[m] = inversesqrt(sum / float(dims.K) + 1e-6);
}
