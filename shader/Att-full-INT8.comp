#version 450

#define TS 256
#define HEAD_DIM 256
#define KV_HEADS 4
#define KV_TOTAL_ROWS (KV_HEADS * HEAD_DIM)
#define NEG_INF -1e30

layout(local_size_x = TS, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Dimensions {
    uint context_length;
} param;

layout(set = 0, binding = 0) readonly buffer keyBuffer { uvec4 key[]; };
layout(set = 0, binding = 1) readonly buffer valueBuffer { uvec4 value[]; };
layout(set = 0, binding = 2) readonly buffer queryBuffer { vec4 query[]; };
layout(set = 0, binding = 3) writeonly buffer outBuffer { float y[]; };
layout(set = 0, binding = 4) readonly buffer kScaleBuffer { float kscale[]; };
layout(set = 0, binding = 5) readonly buffer kZeroBuffer { float kzero[]; };
layout(set = 0, binding = 6) readonly buffer vScaleBuffer { float vscale[]; };
layout(set = 0, binding = 7) readonly buffer vZeroBuffer { float vzero[]; };

shared float q_shared[HEAD_DIM];
shared float s_max[TS];
shared float s_exp[TS];

vec4 unpackUint8x4(uint packedData) {
    return vec4((uvec4(packedData) >> uvec4(0, 8, 16, 24)) & uvec4(0xFF));
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint q_head_id = gl_WorkGroupID.x;
    uint kv_block_id = q_head_id / KV_HEADS;
    uint kv_row_base = kv_block_id * HEAD_DIM;
    uint seq16 = param.context_length / 16;

    if (tid < HEAD_DIM / 4) {
        vec4 qv = query[q_head_id * (HEAD_DIM / 4) + tid];
        q_shared[tid * 4 + 0] = qv.x;
        q_shared[tid * 4 + 1] = qv.y;
        q_shared[tid * 4 + 2] = qv.z;
        q_shared[tid * 4 + 3] = qv.w;
    }
    barrier();

    float m_prev = NEG_INF;
    float d_prev = 0.0;
    float acc = 0.0;

    uint num_tiles = (param.context_length + TS - 1) / TS;
    for (uint k = 0; k < num_tiles; k++) {
        uint s = k * TS + tid;

        float score = NEG_INF;
        if (s < param.context_length) {
            uint sel = s & 15u;
            uint s16 = s / 16;
            score = 0.0;
            for (uint d = 0; d < HEAD_DIM; d++) {
                uvec4 k_raw = key[(kv_row_base + d) * seq16 + s16];
                uint byte = (sel < 4u) ? ((k_raw.x >> (sel * 8u)) & 0xFFu)
                           : (sel < 8u) ? ((k_raw.y >> ((sel - 4u) * 8u)) & 0xFFu)
                           : (sel < 12u) ? ((k_raw.z >> ((sel - 8u) * 8u)) & 0xFFu)
                                         : ((k_raw.w >> ((sel - 12u) * 8u)) & 0xFFu);
                uint row = kv_row_base + d;
                float k_val = float(byte) * kscale[k * KV_TOTAL_ROWS + row] - kzero[k * KV_TOTAL_ROWS + row];
                score += q_shared[d] * k_val;
            }
        }

        s_max[tid] = score;
        barrier();
        for (uint stride = 128; stride > 0; stride >>= 1) {
            if (tid < stride) {
                s_max[tid] = max(s_max[tid], s_max[tid + stride]);
            }
            barrier();
        }
        float tile_max = s_max[0];

        float exp_val = exp(score - tile_max);
        s_exp[tid] = exp_val;
        barrier();
        for (uint stride = 128; stride > 0; stride >>= 1) {
            if (tid < stride) {
                s_exp[tid] += s_exp[tid + stride];
            }
            barrier();
        }
        float tile_sum = s_exp[0];

        if (tile_sum > 0.0) {
            float m_next = max(m_prev, tile_max);
            float alpha = exp(m_prev - m_next);
            float beta = exp(tile_max - m_next);
            d_prev = alpha * d_prev + beta * tile_sum;

            s_exp[tid] = exp_val;
            barrier();

            float vs = vscale[k * KV_TOTAL_ROWS + kv_row_base + tid];
            float vz = vzero[k * KV_TOTAL_ROWS + kv_row_base + tid];

            float tile_acc = 0.0;
            uint tile_start = k * TS;
            uint tile_size = param.context_length - tile_start;
            if (tile_size > TS) tile_size = TS;
            for (uint i = 0; i < tile_size; i += 16) {
                uvec4 v_raw = value[(kv_row_base + tid) * seq16 + (tile_start + i) / 16];
                vec4 w0 = unpackUint8x4(v_raw.x) * vs - vz;
                vec4 w1 = unpackUint8x4(v_raw.y) * vs - vz;
                vec4 w2 = unpackUint8x4(v_raw.z) * vs - vz;
                vec4 w3 = unpackUint8x4(v_raw.w) * vs - vz;
                tile_acc += dot(vec4(s_exp[i], s_exp[i + 1], s_exp[i + 2], s_exp[i + 3]), w0);
                tile_acc += dot(vec4(s_exp[i + 4], s_exp[i + 5], s_exp[i + 6], s_exp[i + 7]), w1);
                tile_acc += dot(vec4(s_exp[i + 8], s_exp[i + 9], s_exp[i + 10], s_exp[i + 11]), w2);
                tile_acc += dot(vec4(s_exp[i + 12], s_exp[i + 13], s_exp[i + 14], s_exp[i + 15]), w3);
            }

            acc = acc * alpha + tile_acc * beta;
            m_prev = m_next;
        }
        barrier();
    }

    if (d_prev > 0.0) {
        y[q_head_id * HEAD_DIM + tid] = acc / d_prev;
    } else {
        y[q_head_id * HEAD_DIM + tid] = 0.0;
    }
}
