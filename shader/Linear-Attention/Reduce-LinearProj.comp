#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint N;
} prm;

layout(set = 0, binding = 0) readonly restrict buffer PartialBuffer { float P[]; };
layout(set = 0, binding = 1) buffer qOutBuffer { float qOut[]; };
layout(set = 0, binding = 2) buffer kOutBuffer { float kOut[]; };
layout(set = 0, binding = 3) buffer vOutBuffer { float vOut[]; };
layout(set = 0, binding = 4) buffer gOutBuffer { float gOut[]; };
layout(set = 0, binding = 5) buffer aOutBuffer { float aOut[]; };
layout(set = 0, binding = 6) buffer bOutBuffer { float bOut[]; };

#define K_OFF 2048
#define V_OFF 4096
#define G_OFF 8192
#define A_OFF 12288
#define B_OFF 12320

void main() {
    uint globalCol = gl_GlobalInvocationID.x;
    if (globalCol >= prm.N) return;

    float acc = 0.0;
    for (uint z = 0; z < 4u; z++) {
        acc += P[z * prm.N + globalCol];
    }

    if (globalCol < K_OFF) {
        qOut[globalCol] = acc;
    } else if (globalCol < V_OFF) {
        kOut[globalCol - K_OFF] = acc;
    } else if (globalCol < G_OFF) {
        vOut[globalCol - V_OFF] = acc;
    } else if (globalCol < A_OFF) {
        gOut[globalCol - G_OFF] = acc;
    } else if (globalCol < B_OFF) {
        aOut[globalCol - A_OFF] = acc;
    } else {
        bOut[globalCol - B_OFF] = acc;
    }
}
