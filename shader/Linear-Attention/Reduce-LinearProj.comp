#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint N;
    uint kOff;
    uint vOff;
    uint zOff;
    uint aOff;
    uint bOff;
} prm;

layout(set = 0, binding = 0) readonly restrict buffer PartialBuffer { float P[]; };
layout(set = 0, binding = 1) buffer qOutBuffer { float qOut[]; };
layout(set = 0, binding = 2) buffer kOutBuffer { float kOut[]; };
layout(set = 0, binding = 3) buffer vOutBuffer { float vOut[]; };
layout(set = 0, binding = 4) buffer zOutBuffer { float zOut[]; };
layout(set = 0, binding = 5) buffer aOutBuffer { float aOut[]; };
layout(set = 0, binding = 6) buffer bOutBuffer { float bOut[]; };

void main() {
    uint globalCol = gl_GlobalInvocationID.x;
    if (globalCol >= prm.N) return;

    float acc = 0.0;
    for (uint z = 0; z < 4u; z++) {
        acc += P[z * prm.N + globalCol];
    }

    if (globalCol < prm.kOff) {
        qOut[globalCol] = acc;
    } else if (globalCol < prm.vOff) {
        kOut[globalCol - prm.kOff] = acc;
    } else if (globalCol < prm.zOff) {
        vOut[globalCol - prm.vOff] = acc;
    } else if (globalCol < prm.aOff) {
        zOut[globalCol - prm.zOff] = acc;
    } else if (globalCol < prm.bOff) {
        aOut[globalCol - prm.aOff] = acc;
    } else {
        bOut[globalCol - prm.bOff] = acc;
    }
}
