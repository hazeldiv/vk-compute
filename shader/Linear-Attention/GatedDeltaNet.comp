#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable
#define TS 128
#define HEAD_DIM 128

layout(local_size_x = TS, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Dimensions {
    uint v_heads;
    uint qk_heads;
    uint head_dim;
} param;

layout(set = 0, binding = 0) readonly buffer QBuffer { float Q[]; };
layout(set = 0, binding = 1) readonly buffer KBuffer { float K[]; };
layout(set = 0, binding = 2) readonly buffer VBuffer { float V[]; };
layout(set = 0, binding = 3) readonly buffer GBuffer { float G[]; };
layout(set = 0, binding = 4) readonly buffer ARawBuffer { float aRaw[]; };
layout(set = 0, binding = 5) readonly buffer BRawBuffer { float bRaw[]; };
layout(set = 0, binding = 6) buffer StateBuffer { vec4 S[]; };
layout(set = 0, binding = 7) buffer YGatedBuffer { float yGated[]; };

shared vec4 k4[HEAD_DIM / 4];
shared vec4 q4[HEAD_DIM / 4];
shared float wave_kq[TS / 64];

void main() {
    uint i = gl_LocalInvocationID.x;
    uint h = gl_WorkGroupID.x;
    uint qk = h >> 1;

    float vv = V[h * HEAD_DIM + i];
    float gv = G[h * HEAD_DIM + i];
    float a_raw = aRaw[qk];
    float b_raw = bRaw[qk];

    if (i < HEAD_DIM / 4) {
        uint b = qk * HEAD_DIM + i * 4;
        k4[i] = vec4(K[b], K[b+1], K[b+2], K[b+3]);
        q4[i] = vec4(Q[b], Q[b+1], Q[b+2], Q[b+3]);
    }
    barrier();

    float alpha = exp(-log(1.0 + exp(a_raw)));
    float beta = 1.0 / (1.0 + exp(-b_raw));

    uvec2 cc = uvec2(i >> 2, i & 3);
    float kq_p = k4[cc.x][cc.y] * q4[cc.x][cc.y];
    float kq_wave = subgroupAdd(kq_p);
    if (subgroupElect()) {
        wave_kq[gl_SubgroupID] = kq_wave;
    }
    barrier();
    if (i == 0) {
        float total = 0.0;
        for (uint w = 0; w < TS / 64; w++) {
            total += wave_kq[w];
        }
        wave_kq[0] = total;
    }
    barrier();
    float kq_dot = wave_kq[0];

    uint base4 = h * (HEAD_DIM * HEAD_DIM / 4) + i * (HEAD_DIM / 4);
    vec4 vhA = vec4(0.0), vhB = vec4(0.0);
    vec4 yA = vec4(0.0), yB = vec4(0.0);
    for (uint j = 0; j < HEAD_DIM / 4; j += 2) {
        vec4 s0 = S[base4 + j];
        vec4 s1 = S[base4 + j + 1];
        vhA += s0 * k4[j];
        vhB += s1 * k4[j+1];
        yA += s0 * q4[j];
        yB += s1 * q4[j+1];
    }
    vec4 vh4 = vhA + vhB;
    vec4 y4 = yA + yB;
    float vhat = vh4.x + vh4.y + vh4.z + vh4.w;
    float y0 = y4.x + y4.y + y4.z + y4.w;
    float delta = vv - vhat;

    float bd = beta * delta;
    for (uint j = 0; j < HEAD_DIM / 4; j++) {
        S[base4 + j] = alpha * S[base4 + j] + bd * k4[j];
    }

    float y = alpha * y0 + beta * delta * kq_dot;
    yGated[h * HEAD_DIM + i] = y * (gv / (1.0 + exp(-gv)));
}
