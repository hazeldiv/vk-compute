#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable
#define TS 256
#define HEAD_DIM 128

layout(local_size_x = TS, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Dimensions {
    uint v_heads;
    uint qk_heads;
    uint head_dim;
} param;

layout(set = 0, binding = 0) readonly buffer QBuffer { float Q[]; };
layout(set = 0, binding = 1) readonly buffer KBuffer { float K[]; };
layout(set = 0, binding = 2) readonly buffer VBuffer { float V[]; };
layout(set = 0, binding = 3) readonly buffer ARawBuffer { float aRaw[]; };
layout(set = 0, binding = 4) readonly buffer BRawBuffer { float bRaw[]; };
layout(set = 0, binding = 5) buffer StateBuffer { vec4 S[]; };
layout(set = 0, binding = 6) buffer YGatedBuffer { float yGated[]; };
layout(set = 0, binding = 7) readonly restrict buffer ZBuffer { float z[]; };
layout(set = 0, binding = 8) readonly restrict buffer WeightBuffer { float wnorm[]; };
layout(set = 0, binding = 9) readonly restrict buffer ALogBuffer { float aLog[]; };
layout(set = 0, binding = 10) readonly restrict buffer DtBiasBuffer { float dtBias[]; };

shared vec4 k4[HEAD_DIM / 4];
shared vec4 q4[HEAD_DIM / 4];
shared float wave_kq[(TS + 31) / 32];
shared float pairV[TS];
shared float pairY[TS];
shared float k_inv;
shared float q_inv;

void main() {
    uint DIM = param.head_dim;
    uint i = gl_LocalInvocationID.x;
    uint h = gl_WorkGroupID.x;
    uint qk = h * param.qk_heads / param.v_heads;
    uint r = i >> 1;
    uint hlf = i & 1u;

    float vv = V[h * DIM + r];
    float a_raw = aRaw[h];
    float b_raw = bRaw[h];

    if (i < DIM / 4) {
        uint b = qk * DIM + i * 4;
        k4[i] = vec4(K[b], K[b+1], K[b+2], K[b+3]);
        q4[i] = vec4(Q[b], Q[b+1], Q[b+2], Q[b+3]);
    }
    barrier();

    if (i == 0u) {
        float ksum = 0.0;
        float qsum = 0.0;
        for (uint j = 0; j < DIM / 4; j++) {
            ksum += dot(k4[j], k4[j]);
            qsum += dot(q4[j], q4[j]);
        }
        k_inv = inversesqrt(ksum + 1e-6);
        q_inv = inversesqrt(qsum + 1e-6) * (1.0 / sqrt(float(DIM)));
    }
    barrier();
    if (i < DIM / 4) {
        k4[i] = k4[i] * k_inv;
        q4[i] = q4[i] * q_inv;
    }
    barrier();

    float g = -exp(aLog[h]) * log(1.0 + exp(a_raw + dtBias[h]));
    float alpha = exp(g);
    float beta = 1.0 / (1.0 + exp(-b_raw));

    uint e = i & (DIM - 1u);
    uvec2 cc = uvec2(e >> 2, e & 3u);
    float kq_p = (i < DIM) ? k4[cc.x][cc.y] * q4[cc.x][cc.y] : 0.0;
    float kq_wave = subgroupAdd(kq_p);
    if (subgroupElect()) {
        wave_kq[gl_SubgroupID] = kq_wave;
    }
    barrier();
    if (i == 0) {
        float total = 0.0;
        for (uint w = 0; w < gl_NumSubgroups; w++) {
            total += wave_kq[w];
        }
        wave_kq[0] = total;
    }
    barrier();
    float kq_dot = wave_kq[0];

    uint base4 = h * (DIM * DIM / 4) + r * (DIM / 4) + hlf * (DIM / 8);
    vec4 vhA = vec4(0.0), vhB = vec4(0.0);
    vec4 yA = vec4(0.0), yB = vec4(0.0);
    for (uint j = 0; j < DIM / 8; j += 2) {
        vec4 s0 = S[base4 + j];
        vec4 s1 = S[base4 + j + 1];
        vhA += s0 * k4[hlf * (DIM / 8) + j];
        vhB += s1 * k4[hlf * (DIM / 8) + j + 1];
        yA += s0 * q4[hlf * (DIM / 8) + j];
        yB += s1 * q4[hlf * (DIM / 8) + j + 1];
    }
    vec4 vh4 = vhA + vhB;
    vec4 y4 = yA + yB;
    float vhat_partial = vh4.x + vh4.y + vh4.z + vh4.w;
    float y0_partial = y4.x + y4.y + y4.z + y4.w;
    pairV[i] = vhat_partial;
    pairY[i] = y0_partial;
    barrier();

    float vhat = vhat_partial + pairV[i ^ 1u];
    float y0 = y0_partial + pairY[i ^ 1u];
    float delta = vv - alpha * vhat;

    float bd = beta * delta;
    for (uint j = 0; j < DIM / 8; j++) {
        S[base4 + j] = alpha * S[base4 + j] + bd * k4[hlf * (DIM / 8) + j];
    }

    float y = alpha * y0 + beta * delta * kq_dot;

    float sy = (hlf == 0u) ? y * y : 0.0;
    float sysum = subgroupAdd(sy);
    if (subgroupElect()) {
        wave_kq[gl_SubgroupID] = sysum;
    }
    barrier();
    if (i == 0u) {
        float total = 0.0;
        for (uint w = 0; w < gl_NumSubgroups; w++) {
            total += wave_kq[w];
        }
        wave_kq[0] = total;
    }
    barrier();
    float inv = inversesqrt(wave_kq[0] / float(DIM) + 1e-6);

    if (hlf == 0u) {
        uint zidx = h * DIM + r;
        float zv = z[zidx];
        yGated[zidx] = y * inv * wnorm[r] * (zv / (1.0 + exp(-zv)));
    }
}
