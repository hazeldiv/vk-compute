#version 450
#define TS 16
#define DIM 128

layout(local_size_x = TS, local_size_y = TS, local_size_z = 1) in;

layout(push_constant) uniform Dimensions { uint M; } param;

layout(set = 0, binding = 0) readonly buffer QBuffer { float Q[]; };
layout(set = 0, binding = 1) readonly buffer KBuffer { float K[]; };
layout(set = 0, binding = 2) readonly buffer VBuffer { float V[]; };
layout(set = 0, binding = 3) readonly buffer ARawBuffer { float aRaw[]; };
layout(set = 0, binding = 4) readonly buffer BRawBuffer { float bRaw[]; };
layout(set = 0, binding = 5) buffer StateBuffer { float S[]; };
layout(set = 0, binding = 6) buffer YGatedBuffer { float yGated[]; };
layout(set = 0, binding = 7) readonly restrict buffer ZBuffer { float z[]; };
layout(set = 0, binding = 8) readonly restrict buffer WeightBuffer { float wnorm[]; };
layout(set = 0, binding = 9) readonly restrict buffer ALogBuffer { float aLog[]; };
layout(set = 0, binding = 10) readonly restrict buffer DtBiasBuffer { float dtBias[]; };

shared float Ks[TS][DIM];
shared float Qs[TS][DIM];
shared float k_inv_sh[TS];
shared float q_inv_sh[TS];
shared float Dk[TS][TS];
shared float Dq[TS][TS];
shared float delta[TS][DIM];
shared float alpha_sh[TS];
shared float beta_sh[TS];
shared float alpha_P[TS + 1];
shared float w_sh[TS];
shared float skv[DIM];
shared float sqv[DIM];
shared float y_sh[DIM];
shared float yinv;

void main() {
    uint r = gl_LocalInvocationID.y;
    uint c = gl_LocalInvocationID.x;
    uint tid = r * TS + c;
    uint h = gl_WorkGroupID.x;
    uint qk = h >> 1;

    uint numChunks = param.M / TS;

    for (uint ch = 0; ch < numChunks; ch++) {
        uint mBase = ch * TS;

        if (tid == 0) {
            for (uint m = 0; m < TS; m++) {
                float a = aRaw[(mBase + m) * 32 + h];
                float b = bRaw[(mBase + m) * 32 + h];
                float g = -exp(aLog[h]) * log(1.0 + exp(a + dtBias[h]));
                alpha_sh[m] = exp(g);
                beta_sh[m] = 1.0 / (1.0 + exp(-b));
            }
            alpha_P[0] = 1.0;
            for (uint m = 0; m < TS; m++) alpha_P[m + 1] = alpha_P[m] * alpha_sh[m];
            for (uint m = 0; m < TS; m++) w_sh[m] = beta_sh[m] / alpha_P[m + 1];
        }
        barrier();

        for (uint i = tid; i < TS * DIM; i += TS * TS) {
            uint m = i / DIM;
            uint d = i % DIM;
            Ks[m][d] = K[(mBase + m) * (16 * DIM) + qk * DIM + d];
            Qs[m][d] = Q[(mBase + m) * (16 * DIM) + qk * DIM + d];
        }
        barrier();

        if (tid < TS) {
            float ksum = 0.0;
            float qsum = 0.0;
            for (uint d = 0; d < DIM; d++) {
                ksum += Ks[tid][d] * Ks[tid][d];
                qsum += Qs[tid][d] * Qs[tid][d];
            }
            k_inv_sh[tid] = inversesqrt(ksum + 1e-6);
            q_inv_sh[tid] = inversesqrt(qsum + 1e-6) * (1.0 / sqrt(float(DIM)));
        }
        barrier();

        for (uint i = tid; i < TS * DIM; i += TS * TS) {
            uint m = i / DIM;
            uint d = i % DIM;
            Ks[m][d] = Ks[m][d] * k_inv_sh[m];
            Qs[m][d] = Qs[m][d] * q_inv_sh[m];
        }
        barrier();

        {
            float dk = 0.0;
            float dq = 0.0;
            for (uint d = 0; d < DIM; d += 4) {
                vec4 kj = vec4(Ks[r][d], Ks[r][d + 1], Ks[r][d + 2], Ks[r][d + 3]);
                vec4 km = vec4(Ks[c][d], Ks[c][d + 1], Ks[c][d + 2], Ks[c][d + 3]);
                dk += dot(kj, km);
                vec4 qm = vec4(Qs[c][d], Qs[c][d + 1], Qs[c][d + 2], Qs[c][d + 3]);
                dq += dot(kj, qm);
            }
            Dk[r][c] = dk;
            Dq[r][c] = dq;
        }
        barrier();

        for (uint m = 0; m < TS; m++) {
            if (tid < DIM) {
                uint i = tid;
                float sk = 0.0;
                float sq = 0.0;
                for (uint d = 0; d < DIM; d += 4) {
                    vec4 sv = vec4(S[h * (DIM * DIM) + i * DIM + d],
                                   S[h * (DIM * DIM) + i * DIM + d + 1],
                                   S[h * (DIM * DIM) + i * DIM + d + 2],
                                   S[h * (DIM * DIM) + i * DIM + d + 3]);
                    vec4 km = vec4(Ks[m][d], Ks[m][d + 1], Ks[m][d + 2], Ks[m][d + 3]);
                    sk += dot(sv, km);
                    vec4 qm = vec4(Qs[m][d], Qs[m][d + 1], Qs[m][d + 2], Qs[m][d + 3]);
                    sq += dot(sv, qm);
                }
                skv[i] = sk;
                sqv[i] = sq;
            }
            barrier();

            if (tid < DIM) {
                uint i = tid;
                float p = 0.0;
                float qc = 0.0;
                for (uint j = 0; j < m; j++) {
                    float wj = w_sh[j];
                    float dj = delta[j][i];
                    p += wj * Dk[j][m] * dj;
                    qc += wj * Dq[j][m] * dj;
                }
                float vm = V[(mBase + m) * (32 * DIM) + h * DIM + i];
                float dv = vm - alpha_P[m + 1] * skv[i] - alpha_P[m + 1] * p;
                delta[m][i] = dv;

                float ym = alpha_sh[m] * (alpha_P[m] * sqv[i] + alpha_P[m] * qc) + beta_sh[m] * dv * Dq[m][m];
                y_sh[i] = ym;
            }
            barrier();
            if (tid == 0u) {
                float tot = 0.0;
                for (uint d = 0; d < DIM; d++) tot += y_sh[d] * y_sh[d];
                yinv = inversesqrt(tot / float(DIM) + 1e-6);
            }
            barrier();
            if (tid < DIM) {
                uint gi = (mBase + m) * (32 * DIM) + h * DIM + tid;
                float zv = z[gi];
                yGated[gi] = y_sh[tid] * yinv * wnorm[tid] * (zv / (1.0 + exp(-zv)));
            }
            barrier();
        }

        for (uint idx = tid; idx < DIM * DIM; idx += TS * TS) {
            uint i = idx / DIM;
            uint d = idx % DIM;
            float acc = 0.0;
            for (uint m = 0; m < TS; m++) {
                acc += w_sh[m] * delta[m][i] * Ks[m][d];
            }
            float s_old = S[h * (DIM * DIM) + i * DIM + d];
            S[h * (DIM * DIM) + i * DIM + d] = alpha_P[TS] * (s_old + acc);
        }
        barrier();
    }
}
