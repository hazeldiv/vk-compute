#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

#define TS 256
#define HEAD_DIM 256
#define NEG_INF -1e30

layout(local_size_x = TS, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Dimensions {
    uint context_length;
} param;

layout(set = 0, binding = 0) readonly buffer keyBuffer { uvec4 key[]; };
layout(set = 0, binding = 1) readonly buffer valueBuffer { uvec4 value[]; };
layout(set = 0, binding = 2) readonly buffer queryBuffer { uvec4 query[]; };
layout(set = 0, binding = 3) writeonly buffer outBuffer { float y[]; };

shared float q_shared[HEAD_DIM];
shared float s_max[TS];
shared float s_exp[TS];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint q_head_id = gl_WorkGroupID.x;
    uint kv_block_id = q_head_id / 4;
    uint kv_row_base = kv_block_id * HEAD_DIM;
    uint seq8 = param.context_length / 8;

    if (tid < HEAD_DIM / 8) {
        uvec4 q_raw = query[q_head_id * (HEAD_DIM / 8) + tid];
        vec4 lo = vec4(unpackHalf2x16(q_raw.x), unpackHalf2x16(q_raw.y));
        vec4 hi = vec4(unpackHalf2x16(q_raw.z), unpackHalf2x16(q_raw.w));
        q_shared[tid * 8 + 0] = lo.x;
        q_shared[tid * 8 + 1] = lo.y;
        q_shared[tid * 8 + 2] = lo.z;
        q_shared[tid * 8 + 3] = lo.w;
        q_shared[tid * 8 + 4] = hi.x;
        q_shared[tid * 8 + 5] = hi.y;
        q_shared[tid * 8 + 6] = hi.z;
        q_shared[tid * 8 + 7] = hi.w;
    }
    barrier();

    float m_prev = NEG_INF;
    float d_prev = 0.0;
    float acc = 0.0;

    uint num_tiles = (param.context_length + TS - 1) / TS;
    for (uint k = 0; k < num_tiles; k++) {
        uint s = k * TS + tid;

        float score = NEG_INF;
        if (s < param.context_length) {
            uint sel = s & 7u;
            uint s8 = s / 8;
            score = 0.0;
            for (uint d = 0; d < HEAD_DIM; d++) {
                uvec4 k_raw = key[(kv_row_base + d) * seq8 + s8];
                vec4 k0 = vec4(unpackHalf2x16(k_raw.x), unpackHalf2x16(k_raw.y));
                vec4 k1 = vec4(unpackHalf2x16(k_raw.z), unpackHalf2x16(k_raw.w));
                float k_val = (sel < 4u) ? k0[sel] : k1[sel - 4u];
                score += q_shared[d] * k_val;
            }
        }

        s_max[tid] = score;
        barrier();
        for (uint stride = 128; stride > 0; stride >>= 1) {
            if (tid < stride) {
                s_max[tid] = max(s_max[tid], s_max[tid + stride]);
            }
            barrier();
        }
        float tile_max = s_max[0];

        float exp_val = exp(score - tile_max);
        s_exp[tid] = exp_val;
        barrier();
        for (uint stride = 128; stride > 0; stride >>= 1) {
            if (tid < stride) {
                s_exp[tid] += s_exp[tid + stride];
            }
            barrier();
        }
        float tile_sum = s_exp[0];

        if (tile_sum > 0.0) {
            float m_next = max(m_prev, tile_max);
            float alpha = exp(m_prev - m_next);
            float beta = exp(tile_max - m_next);
            d_prev = alpha * d_prev + beta * tile_sum;

            s_exp[tid] = exp_val;
            barrier();

            float tile_acc = 0.0;
            uint tile_start = k * TS;
            uint tile_size = param.context_length - tile_start;
            if (tile_size > TS) tile_size = TS;
            for (uint i = 0; i < tile_size; i += 8) {
                uvec4 v_raw = value[(kv_row_base + tid) * seq8 + (tile_start + i) / 8];
                vec4 v0 = vec4(unpackHalf2x16(v_raw.x), unpackHalf2x16(v_raw.y));
                vec4 v1 = vec4(unpackHalf2x16(v_raw.z), unpackHalf2x16(v_raw.w));
                tile_acc += dot(vec4(s_exp[i], s_exp[i + 1], s_exp[i + 2], s_exp[i + 3]), v0);
                tile_acc += dot(vec4(s_exp[i + 4], s_exp[i + 5], s_exp[i + 6], s_exp[i + 7]), v1);
            }

            acc = acc * alpha + tile_acc * beta;
            m_prev = m_next;
        }
        barrier();
    }

    if (d_prev > 0.0) {
        y[q_head_id * HEAD_DIM + tid] = acc / d_prev;
    } else {
        y[q_head_id * HEAD_DIM + tid] = 0.0;
    }
}
