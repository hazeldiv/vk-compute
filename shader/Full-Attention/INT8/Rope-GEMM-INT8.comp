#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require
#define TS 256
#define HEAD_DIM 256
#define HALF 128
#define MAXCTX 32768

layout(local_size_x = TS, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint N;
    uint kOffset;
    uint vOffset;
    uint tokBase;
} param;

layout(set = 0, binding = 0) readonly restrict buffer RawBuffer { float raw[]; };
layout(set = 0, binding = 1) buffer qOutBuffer { float qOut[]; };
layout(set = 0, binding = 2) buffer kCacheBuffer { uint8_t kCache[]; };
layout(set = 0, binding = 3) buffer vCacheBuffer { uint8_t vCache[]; };
layout(set = 0, binding = 4) buffer kScaleBuffer { float kScale[]; };
layout(set = 0, binding = 5) buffer kZeroBuffer { float kZero[]; };
layout(set = 0, binding = 6) buffer vScaleBuffer { float vScale[]; };
layout(set = 0, binding = 7) buffer vZeroBuffer { float vZero[]; };
layout(set = 0, binding = 8) readonly restrict buffer thetaBuffer { float theta[]; };

shared float acc_shared[TS];
shared float rope_shared[TS];
shared float shared_sum2;
shared float val_shared[TS];
shared float qscale_sh;
shared float qzero_sh;

const float EPSILON = 1e-5;

void quantizeParams(float v) {
    uint i = gl_LocalInvocationID.x;
    val_shared[i] = v;
    barrier();
    if (i == 0) {
        float mn = val_shared[0];
        float mx = val_shared[0];
        for (uint j = 1; j < TS; j++) {
            mn = min(mn, val_shared[j]);
            mx = max(mx, val_shared[j]);
        }
        qscale_sh = (mx - mn) / 255.0;
        if (qscale_sh == 0.0) qscale_sh = 1.0;
        qzero_sh = -mn;
    }
    barrier();
}

uint quantize(float v) {
    float q = (v + qzero_sh) / qscale_sh;
    int qi = int(round(q));
    if (qi < 0) qi = 0;
    if (qi > 255) qi = 255;
    return uint(qi);
}

void main() {
    uint col = gl_LocalInvocationID.x;
    uint head = gl_WorkGroupID.x;
    uint row = gl_WorkGroupID.y;
    uint globalCol = head * HEAD_DIM + col;
    uint token = param.tokBase + row;
    uint cacheSlot = token * (param.vOffset - param.kOffset);

    float acc = raw[row * param.N + globalCol];

    if (globalCol >= param.vOffset) {
        uint kvHead = head - param.vOffset / HEAD_DIM;
        quantizeParams(acc);
        vCache[cacheSlot + (globalCol - param.vOffset)] = uint8_t(quantize(acc));
        if (col == 0) {
            vScale[kvHead * MAXCTX + token] = qscale_sh;
            vZero[kvHead * MAXCTX + token] = qzero_sh;
        }
        return;
    }

    acc_shared[col] = acc;
    barrier();

    if (col == 0) {
        float final_sum = 0.0;
        for (uint i = 0; i < TS; i++) {
            final_sum += acc_shared[i] * acc_shared[i];
        }
        shared_sum2 = final_sum;
    }
    barrier();
    float inv_rms2 = 1.0 / sqrt((shared_sum2 / float(HEAD_DIM)) + EPSILON);

    rope_shared[col] = acc * inv_rms2;
    barrier();

    float angle = float(token) * theta[col & (HALF - 1u)];
    float cos_a = cos(angle);
    float sin_a = sin(angle);
    if (col < HALF) {
        acc = rope_shared[col] * cos_a - rope_shared[col + HALF] * sin_a;
    } else {
        acc = rope_shared[col - HALF] * sin_a + rope_shared[col] * cos_a;
    }

    if (globalCol < param.kOffset) {
        qOut[row * param.kOffset + globalCol] = acc;
    } else {
        uint kvHead = head - param.kOffset / HEAD_DIM;
        quantizeParams(acc);
        kCache[cacheSlot + (globalCol - param.kOffset)] = uint8_t(quantize(acc));
        if (col == 0) {
            kScale[kvHead * MAXCTX + token] = qscale_sh;
            kZero[kvHead * MAXCTX + token] = qzero_sh;
        }
    }
}
