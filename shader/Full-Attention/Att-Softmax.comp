#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#define NEG_INF -1e30
#define TS 256

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform P { uint ctxLen; uint qOff; uint mRows; uint headBase; uint maxCtx; uint kvHeads; uint qDim; uint kvRows; uint gqa; } param;

layout(set = 0, binding = 0) buffer S { float16_t s[]; };
layout(set = 0, binding = 1) writeonly restrict buffer SmSum { float smSum[]; };

shared float sub_max[(TS + 31) / 32];
shared float sub_sum[(TS + 31) / 32];

void main() {
    uint row = gl_WorkGroupID.x;
    uint hL = gl_WorkGroupID.y;
    uint lane = gl_LocalInvocationID.x;
    uint MAXCTX = param.maxCtx;
    uint pRow = (hL * param.mRows + row) * MAXCTX;
    uint limit = param.qOff + row;

    float mx = NEG_INF;
    for (uint t = lane; t < param.ctxLen; t += 256) {
        if (t <= limit) {
            float v = float(s[pRow + t]);
            if (v > mx) mx = v;
        }
    }
    mx = subgroupMax(mx);
    if (subgroupElect()) sub_max[gl_SubgroupID] = mx;
    barrier();
    float gmax = sub_max[0];
    for (uint i = 1u; i < gl_NumSubgroups; i++) gmax = max(gmax, sub_max[i]);

    float sum = 0.0;
    for (uint t = lane; t < param.ctxLen; t += 256) {
        float v = exp(float(s[pRow + t]) - gmax);
        s[pRow + t] = float16_t(v);
        sum += v;
    }
    sum = subgroupAdd(sum);
    if (subgroupElect()) sub_sum[gl_SubgroupID] = sum;
    barrier();
    float total = sub_sum[0];
    for (uint i = 1u; i < gl_NumSubgroups; i++) total += sub_sum[i];
    smSum[hL * param.mRows + row] = 1.0 / total;
}
