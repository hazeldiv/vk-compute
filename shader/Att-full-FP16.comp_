#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_shader_atomic_float : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define TS 256
#define vec 4
#define head_dim 256

layout(local_size_x = TS, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Dimensions {
    uint M;
    uint N;
    uint K;
    uint context_length;
} param;

const float NEG_INF = -1e30;

layout(set = 0, binding = 0) readonly buffer keyBuffer { uvec4 key[]; };
layout(set = 0, binding = 1) readonly buffer valueBuffer { uvec4 value[]; };
layout(set = 0, binding = 2) readonly buffer queryBuffer { uvec4 query[]; };
layout(set = 0, binding = 3) writeonly buffer outBuffer { float y[]; };

shared vec4 cache[head_dim/vec];
shared vec4 shared_K[TS];
shared vec4 shared_V[TS];

void main() {
    uint col = gl_LocalInvocationID.x;
    uint globalCol = gl_WorkGroupID.x*TS + col;
    if (globalCol >= param.N) return;

    // 16 head, 4 kv, 256 head_dim
    uint q_head_id = gl_WorkGroupID.x;
    uint kv_block_id = q_head_id / 4;
    uint kv_offset = kv_block_id * head_dim;
    uint kv_offset_vec = kv_offset / 8;
    uint q_base = q_head_id * 32;

    // Query is 64 vec4 (32 * 4) therefore only 64 threads are needed
    if (col < head_dim/vec) {
        cache[col] = query[q_base + col];
    }

    barrier();

    float m_prev = NEG_INF;
    float d_prev = 0.0; 
    float r_O[32];
    for (uint i = 0; i < 32; i++) {
        r_O[i] = 0.0;
    }

    uint num_tiles = (param.context_length + TS - 1) / TS;

    // Loop over number of tiles based on context length / tile size (256)
    for (uint t = 0; t < num_tiles; t++) {
        uint tile_row = t * TS + col;
        // If the tile row exceeds the context length, skip this iteration
        if (tile_row >= param.context_length) {
            barrier();
            continue;
        }

        // Load K and V into shared memory
        uint k_base = tile_row + kv_offset_vec;
        uint v_base = kv_offset_vec * param.context_length + tile_row;

        shared_K[col] = key[k_base];
        shared_V[col] = value[v_base];

        barrier();

        float r_S[TS];
        for (uint i = 0; i < TS; i++) {
            if (tile_row + i >= param.context_length) break;
            float score = 0.0;
            uvec4 k_raw = shared_K[i];
            vec4 k0 = vec4(unpackHalf2x16(k_raw.x), unpackHalf2x16(k_raw.y));
            vec4 k1 = vec4(unpackHalf2x16(k_raw.z), unpackHalf2x16(k_raw.w));
            for (uint k = 0; k < 32; k++) {
                score += dot(cache[k], k0);
                score += dot(cache[k + 32], k1);
            }
            r_S[i] = score;
        }

        float m_local = NEG_INF;
        for (uint i = 0; i < TS; i++) {
            if (tile_row + i >= param.context_length) break;
            m_local = max(m_local, r_S[i]);
        }

        float d_local = 0.0;
        float r_P[TS];
        for (uint i = 0; i < TS; i++) {
            if (tile_row + i >= param.context_length) break;
            r_P[i] = exp(r_S[i] - m_local);
            d_local += r_P[i];
        }

        float m_next = max(m_prev, m_local);
        float alpha = exp(m_prev - m_next);
        float beta = exp(m_local - m_next);
        float d_next = alpha * d_prev + beta * d_local;

        for (uint d = 0; d < 32; d++) {
            float v_sum = 0.0;
            for (uint i = 0; i < TS; i++) {
                if (tile_row + i >= param.context_length) break;
                uvec4 v_raw = shared_V[i];
                vec4 v0 = vec4(unpackHalf2x16(v_raw.x), unpackHalf2x16(v_raw.y));
                vec4 v1 = vec4(unpackHalf2x16(v_raw.z), unpackHalf2x16(v_raw.w));
                v_sum += r_P[i] * ((d < 16) ? v0[d] : v1[d - 16]);
            }
            r_O[d] = (alpha * d_prev * r_O[d] + beta * v_sum) / d_next;
        }

        m_prev = m_next;
        d_prev = d_next;

        memoryBarrierShared();
        barrier();
    }

    if (col < TS) {
        uint out_idx = q_head_id * head_dim + col;
        y[out_idx] = r_O[col];
    }
}
